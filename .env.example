# Free tier at https://the-odds-api.com (sign up, ~500 requests/month free).
# Without this, games/Elo ratings/weather still work — odds comparison and
# the edge feed are disabled with a friendly message instead.
ODDS_API_KEY=

PORT=3001

# Origin allowed to call the API (CORS). Defaults to the Vite dev server
# (http://localhost:5173) if unset — only change this if you're serving the
# frontend from somewhere else.
CORS_ORIGIN=
